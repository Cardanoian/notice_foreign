<div class="w-full max-w-4xl mx-auto pt-4">
  <div class="mb-8 anim-fade-up">
    <%= link_to root_path, class: "btn-ghost text-sm" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      학교 검색으로 돌아가기
    <% end %>
  </div>

  <div class="mb-10 anim-fade-up delay-100">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-2"><%= @school.name %></h1>
    <% if @school.location.present? %>
      <p class="text-slate-400 flex items-center gap-2">
        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <%= @school.location %>
      </p>
    <% end %>
    <hr class="neon-line-subtle mt-6">
  </div>

  <div class="mb-6 anim-fade-up delay-200 flex items-center gap-3">
    <div class="icon-box">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
    </div>
    <h2 class="text-xl font-bold text-white">안내장 목록</h2>
  </div>

  <div class="space-y-3">
    <% if @docs.empty? %>
      <div class="glass-card-static text-center py-16">
        <svg class="w-12 h-12 mx-auto mb-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <p class="text-slate-500">등록된 안내장이 없습니다</p>
      </div>
    <% else %>
      <% @docs.each_with_index do |doc, idx| %>
        <%= link_to school_doc_path(@school, doc), class: "block glass-card p-5 sm:p-6 anim-fade-up", style: "animation-delay: #{(idx + 3) * 80}ms" do %>
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h3 class="text-lg font-semibold text-white truncate"><%= doc.title %></h3>
              <p class="text-sm text-slate-400 mt-1.5 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <%= doc.original_doc.uploaded_at&.strftime('%Y년 %m월 %d일') %>
              </p>
            </div>
            <span class="badge shrink-0 <%= doc.language == 'ko' ? 'badge-green' : 'badge-blue' %>">
              <%= doc.language.upcase %>
            </span>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
