<div class="w-full max-w-4xl mx-auto pt-4">
  <div class="mb-6 anim-fade-up">
    <%= link_to admin_original_docs_path, class: "btn-ghost text-sm" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      목록으로 돌아가기
    <% end %>
  </div>

  <div class="glass-card-static overflow-hidden anim-fade-up delay-100">
    <div class="px-6 py-5 border-b border-white/5">
      <h1 class="text-xl font-bold text-white">문서 상세</h1>
      <div class="mt-3 flex flex-wrap items-center gap-3 text-sm">
        <span class="badge badge-blue font-mono">#<%= @original_doc.id %></span>
        <span class="text-slate-400"><%= @original_doc.school.name %></span>
        <span class="text-slate-500"><%= @original_doc.uploaded_at&.strftime('%Y-%m-%d %H:%M') %></span>
        <% status_badge = { 'pending' => 'badge-yellow', 'processing' => 'badge-blue', 'completed' => 'badge-green', 'failed' => 'badge-coral' } %>
        <span class="badge <%= status_badge[@original_doc.status] %>">
          <%= @original_doc.status %>
        </span>
      </div>
    </div>

    <div class="px-6 py-5">
      <h2 class="text-base font-bold text-white mb-4 flex items-center gap-2">
        <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/></svg>
        번역 언어 목록
        <span class="badge badge-teal"><%= @docs.count %>개</span>
      </h2>

      <% if @docs.any? %>
        <div class="overflow-x-auto">
          <table class="table-modern">
            <thead>
              <tr>
                <th>언어</th>
                <th>제목</th>
                <th>생성일</th>
              </tr>
            </thead>
            <tbody>
              <% @docs.each do |doc| %>
                <tr>
                  <td>
                    <span class="badge badge-blue">
                      <%= doc.language %>
                    </span>
                  </td>
                  <td class="text-white font-medium"><%= doc.title %></td>
                  <td class="text-slate-400"><%= doc.created_at.strftime('%Y-%m-%d %H:%M') %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-12">
          <svg class="w-10 h-10 mx-auto mb-3 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/></svg>
          <p class="text-slate-500">아직 번역된 문서가 없습니다.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
