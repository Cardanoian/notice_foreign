<div class="w-full max-w-2xl mx-auto pt-4">
  <div class="mb-8 anim-fade-up">
    <%= link_to admin_original_docs_path, class: "btn-ghost text-sm" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      목록으로 돌아가기
    <% end %>
  </div>

  <div class="flex items-center gap-3 mb-8 anim-fade-up delay-100">
    <div class="icon-box">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
    </div>
    <h1 class="text-2xl font-extrabold text-white">새 문서 업로드</h1>
  </div>

  <div class="glass-card-static p-6 sm:p-8 anim-fade-up delay-200">
    <%= form_with model: [:admin, @original_doc], class: "space-y-7" do |form| %>
      <% if @original_doc.errors.any? %>
        <div class="flash-error">
          <ul class="text-sm space-y-1">
            <% @original_doc.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <span class="block text-sm font-semibold text-slate-300 mb-2.5">학교</span>
        <p class="px-4 py-3 bg-white/[0.03] border border-white/5 rounded-xl text-slate-400 flex items-center gap-2">
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          <%= Current.user.school.name %>
        </p>
      </div>

      <div>
        <%= form.label :file, "파일 업로드", class: "block text-sm font-semibold text-slate-300 mb-2.5" %>
        <%= form.file_field :file, accept: ".txt,.pdf,.jpg,.jpeg,.png,.gif,.bmp,.webp,.tiff,.tif,.svg,.heic,.heif", class: "file-input-modern" %>
        <p class="text-xs text-slate-500 mt-2">TXT, PDF, 이미지 파일(JPG, PNG, GIF, BMP, WebP, TIFF, SVG, HEIC)을 지원합니다</p>
      </div>

      <div class="relative">
        <hr class="neon-line-subtle">
        <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 px-3 text-xs text-slate-500 bg-[#1e293b]">또는</span>
      </div>

      <div>
        <%= form.label :original_file, "직접 입력", class: "block text-sm font-semibold text-slate-300 mb-2.5" %>
        <%= form.text_area :original_file, rows: 10, placeholder: "안내장 내용을 직접 입력하세요...", class: "textarea-modern" %>
      </div>

      <div class="pt-3">
        <%= form.submit "업로드 및 처리 시작", class: "btn-primary w-full justify-center text-base !py-3.5 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
