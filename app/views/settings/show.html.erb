<div class="w-full max-w-2xl mx-auto pt-4">
  <div class="flex items-center gap-3 mb-8 anim-fade-up">
    <div class="icon-box">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    </div>
    <h1 class="text-2xl font-extrabold text-white"><%= t('settings.title') %></h1>
  </div>

  <div class="glass-card-static p-6 sm:p-8 anim-fade-up delay-100">
    <%= form_with model: @user, url: settings_path, method: :patch, class: "space-y-7" do |form| %>
      <% if @user.errors.any? %>
        <div class="flash-error">
          <ul class="text-sm space-y-1">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <label class="block text-sm font-semibold text-white mb-2.5"><%= t('settings.email') %></label>
        <p class="px-4 py-3 bg-white/[0.03] border border-white/5 rounded-xl text-white"><%= @user.email_address %></p>
      </div>

      <div>
        <%= form.label :school_id, t('settings.school'), class: "block text-sm font-semibold text-white mb-2.5" %>
        <%= form.collection_select :school_id, @schools, :id, :name, { prompt: t('settings.school_placeholder') }, class: "select-modern" %>
      </div>

      <div>
        <label class="block text-sm font-semibold text-white mb-2"><%= t('settings.translation_languages') %></label>
        <p class="text-sm text-white mb-4"><%= t('settings.translation_description') %></p>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <% User::AVAILABLE_LANGUAGES.each do |code, name| %>
            <label class="flex items-center gap-3 px-4 py-3 rounded-xl border border-white/6 bg-white/[0.02] hover:bg-white/[0.05] cursor-pointer transition-all has-[:checked]:border-blue-500/30 has-[:checked]:bg-blue-500/8 has-[:checked]:shadow-[0_0_15px_rgba(59,125,216,0.08)]">
              <input
                type="checkbox"
                name="user[selected_languages][]"
                value="<%= code %>"
                <%= "checked" if @user.selected_languages.include?(code) %>
                class="checkbox-modern"
              />
              <span class="text-sm text-white"><%= name %></span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="pt-3">
        <%= form.submit t('settings.save'), class: "btn-primary w-full justify-center text-base !py-3.5 cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="mt-8 anim-fade-up delay-300">
    <%= link_to admin_original_docs_path, class: "btn-ghost text-sm" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      <%= t('settings.back_to_docs') %>
    <% end %>
  </div>
</div>
