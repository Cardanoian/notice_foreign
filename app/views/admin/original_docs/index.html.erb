<div class="w-full max-w-6xl mx-auto pt-4">
  <div class="flex items-center justify-between mb-8 anim-fade-up">
    <div class="flex items-center gap-3">
      <div class="icon-box">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
      </div>
      <h1 class="text-2xl font-extrabold text-white"><%= t('admin.docs.title') %></h1>
    </div>
    <%= link_to new_admin_original_doc_path, class: "btn-primary text-sm" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span><%= t('admin.docs.new_upload') %></span>
    <% end %>
  </div>

  <div class="glass-card-static overflow-hidden anim-fade-up delay-100">
    <div class="overflow-x-auto">
      <table class="table-modern">
        <thead>
          <tr>
            <th><%= t('admin.docs.table_id') %></th>
            <th><%= t('admin.docs.table_school') %></th>
            <th><%= t('admin.docs.table_date') %></th>
            <th><%= t('admin.docs.table_status') %></th>
            <th><%= t('admin.docs.table_translations') %></th>
            <th><%= t('admin.docs.table_actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% @original_docs.each do |doc| %>
            <tr>
              <td class="font-mono text-white">#<%= doc.id %></td>
              <td class="text-white font-medium"><%= doc.school.name %></td>
              <td class="text-white"><%= doc.uploaded_at&.strftime('%Y-%m-%d %H:%M') %></td>
              <td>
                <% status_badge = { 'pending' => 'badge-yellow', 'processing' => 'badge-blue', 'completed' => 'badge-green', 'failed' => 'badge-coral' } %>
                <span class="badge <%= status_badge[doc.status] %>">
                  <%= doc.status %>
                </span>
              </td>
              <td>
                <span class="badge badge-teal"><%= doc.docs.count %><%= t('admin.docs.count_suffix') %></span>
              </td>
              <td>
                <div class="flex items-center gap-3">
                  <%= link_to t('admin.docs.view'), admin_original_doc_path(doc), class: "text-blue-400 hover:text-blue-300 text-sm font-medium transition-colors" %>
                  <%= button_to admin_original_doc_path(doc), method: :delete, data: { turbo_confirm: t('admin.docs.delete_confirm') }, class: "btn-danger !py-1.5 !px-3 text-xs" do %>
                    <%= t('admin.docs.delete') %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @original_docs.empty? %>
      <div class="text-center py-16">
        <svg class="w-12 h-12 mx-auto mb-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <p class="text-white"><%= t('admin.docs.no_docs') %></p>
      </div>
    <% end %>
  </div>
</div>
