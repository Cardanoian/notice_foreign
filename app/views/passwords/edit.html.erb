<div class="max-w-md mx-auto pt-8 sm:pt-16">
  <% if alert = flash[:alert] %>
    <div class="flash-error mb-6" id="alert"><%= alert %></div>
  <% end %>

  <div class="glass-card-static p-8 sm:p-10 anim-fade-scale">
    <div class="text-center mb-8">
      <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-[#E85D5D] to-[#3B7DD8] flex items-center justify-center shadow-lg shadow-blue-500/25 anim-float">
        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
      </div>
      <h1 class="text-2xl font-extrabold text-white"><%= t('passwords.reset_title') %></h1>
      <p class="text-white mt-2 text-sm"><%= t('passwords.reset_description') %></p>
    </div>

    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-6" do |form| %>
      <div>
        <label class="block text-sm font-semibold text-white mb-2.5"><%= t('passwords.new_password') %></label>
        <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: t('passwords.new_password_placeholder'), maxlength: 72, class: "input-modern" %>
      </div>

      <div>
        <label class="block text-sm font-semibold text-white mb-2.5"><%= t('passwords.confirm_password') %></label>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: t('passwords.confirm_password_placeholder'), maxlength: 72, class: "input-modern" %>
      </div>

      <div class="pt-1">
        <%= form.submit t('passwords.change_password'), class: "btn-primary w-full justify-center !py-3.5 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
